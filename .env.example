# TMDB "API Read Access Token" is v4; this app uses the simpler v3 "API Key".
# Get one free at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Supabase project (Settings -> API in your Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is the public/publishable key — safe for the browser,
# access is enforced by Postgres Row Level Security. Never put a service-role
# key here or anywhere in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
